{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/mint-gate.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "td-harvester",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/harvest-completion-gate.py\""
          }
        ]
      }
    ]
  }
}
