<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.thingdaddy.loops</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{PYTHON}}</string>
    <string>{{ROOT}}/run_all.py</string>
    <string>--db</string><string>{{ROOT}}/civilization.db</string>
    <string>--config</string><string>{{ROOT}}/config.yaml</string>
    <string>--out</string><string>{{ROOT}}/out</string>
  </array>
  <key>WorkingDirectory</key><string>{{ROOT}}</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>{{ROOT}}/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>{{ROOT}}/logs/launchd.err.log</string>
</dict>
</plist>
