# Copy to apps/web/.env (git-ignored). All optional.

# Origin of the population API used by the registry UI (/registry).
# Unset: same origin in a production build (the Docker image serves API + app
# together), http://localhost:8787 under `npm run dev`.
VITE_API_BASE=

# Sub-path the site is served from. Unset for a root/custom domain,
# /thingdaddy for GitHub Pages. Only read at build time.
VITE_BASE=

# Dev caller token for the registry's write actions (register / claim). Must
# equal INGEST_TOKEN in apps/api/.env. Unset = registry runs read-only.
VITE_INGEST_TOKEN=
