# ThingDaddy Population API — DB connection + service config.
# Copy to `.env` (git-ignored) and adjust for your local Postgres.
#
#   cp .env.example .env
#
# The API talks ONLY to the thingdaddy_population database created by
# population/db/apply.sh. It never reaches into platform/ or agents/.

# --- Postgres connection (standard libpq / node-pg env names) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=thingdaddy_population
# On a default Homebrew/Postgres.app Mac install the role is your macOS username
# and no password is set. Fill these in only if your instance requires them.
PGUSER=
PGPASSWORD=

# --- HTTP service ---
PORT=8787

# Origin allowed to call this API from a browser (the Population UI). Use '*' for
# local dev, or pin it to the UI origin, e.g. http://localhost:5173.
CORS_ORIGIN=*
