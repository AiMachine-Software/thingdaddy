# ThingDaddy deployable demo — copy to .env only if you want to change a port.
#   cp .env.example .env
# Every value below already has a working default in docker-compose.yml, so the
# demo runs with NO .env file at all.

# ── Host ports ───────────────────────────────────────────────────────────────
# The page + API. Open http://localhost:$WEB_PORT/ in a browser.
# NOT 8787 (KJ's bare `node server.js` demo holds it) and NOT 8788
# (thingdaddy-staging-api-1 holds it). 8789 was free.
WEB_PORT=8789

# Postgres, exposed on the host only so you can psql into it. The app does not
# use this port — it reaches the database over the compose network on 5432.
# NOT 5432 (taxmap-survey-db-1) and NOT 5433 (td-demo-pg).
DB_PORT=5434

# ── Database ─────────────────────────────────────────────────────────────────
# The seed creates its tables inside POSTGRES_DB. Keeping the name
# thingdaddy_population means population/api/.env.example needs no change.
POSTGRES_DB=thingdaddy_population
POSTGRES_USER=postgres
# Local demo only. This database holds a dated snapshot of public GS1 rows and
# is not reachable from outside the host. Change it for any real deployment.
POSTGRES_PASSWORD=thingdaddy

# ── API ──────────────────────────────────────────────────────────────────────
# Browser origin allowed to call the API. The demo page is served from the SAME
# origin as the API, so CORS is not used at all — this only matters if you point
# some other front end at this container.
CORS_ORIGIN=*
