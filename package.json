{
  "name": "thingdaddy",
  "private": true,
  "version": "1.0.0",
  "description": "ThingDaddy monorepo: apps/web (React: platform + registry + demo pages) and apps/api (Express + Postgres population API). Python fleet and data tooling stay under agents/ and population/.",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "preview": "npm --workspace apps/web run preview",
    "parse-check": "npm --workspace apps/web run parse-check",
    "dev:api": "npm --workspace apps/api run dev",
    "start:api": "npm --workspace apps/api run start"
  }
}
