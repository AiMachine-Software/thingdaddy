{
  "name": "thingdaddy",
  "private": true,
  "version": "1.0.0",
  "description": "ThingDaddy monorepo: platform (React), population UI (React), population API (Express + Postgres), and the static demo pages. `npm run build` assembles the whole static site into dist/.",
  "type": "module",
  "workspaces": [
    "platform",
    "population/ui",
    "population/api"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node web/build-site.mjs",
    "preview": "node web/build-site.mjs --preview",
    "dev:platform": "npm --workspace platform run dev",
    "dev:population": "npm --workspace population/ui run dev",
    "dev:api": "npm --workspace population/api run dev",
    "start:api": "npm --workspace population/api run start"
  }
}
